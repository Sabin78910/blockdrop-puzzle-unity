<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tunes every level with simulated players and rewrites Assets/Scripts/Core/LevelTable.cs.
       Run from the repo root: dotnet run -c Release -project tools/LevelTuner -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" Exclude="../../Assets/Scripts/Core/LevelTable.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
