{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet test tools/CoreTests:*)",
      "Bash(node --test CloudCode/:*)",
      "Bash(\"$UNITY\" -batchmode -nographics -projectPath . -runTests:*)",
      "Bash(\"$UNITY\" -batchmode -quit -projectPath . -executeMethod BlockDrop.EditorTools.BuildScript.BuildAndroid:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git tag:*)",
      "Bash(gh pr merge:*)",
      "Bash(ugs deploy:*)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh secret:*)",
      "Bash(gh release create:*)",
      "Bash(fastlane:*)",
      "Bash(bundle exec fastlane:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Edit(./**/*.keystore)",
      "Edit(./**/*.jks)"
    ]
  }
}
